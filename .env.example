# Copy to .env.local for your own computer, and add the same two values in Vercel:
# Project > Settings > Environment Variables. Never commit real values.
# The board works without these; results then stay on the board.

# Supabase > Project Settings > API (or "API Keys"). Both are meant to be public:
# row level security in the database decides what each teacher can see.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" key, or the newer "publishable" key (starts with sb_publishable_). Either works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# No secret / service role key is needed anywhere in this app. Don't add one.
